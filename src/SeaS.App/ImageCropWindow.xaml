<Window x:Class="SeaS.App.ImageCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="裁剪封面"
        Width="620"
        Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FBFD"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Grid x:Name="DialogRoot" Margin="28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Foreground="#14243A" FontSize="20" FontWeight="SemiBold" Text="裁剪封面" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="304" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CropFrame"
                    Width="270"
                    Height="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#EAF2F7"
                    BorderBrush="#DCEBF8"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="6"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="CropFrame_MouseLeftButtonDown"
                    MouseLeftButtonUp="CropFrame_MouseLeftButtonUp"
                    MouseMove="CropFrame_MouseMove"
                    MouseWheel="CropFrame_MouseWheel">
                <Canvas x:Name="CropCanvas"
                        Background="#EAF2F7"
                        ClipToBounds="True">
                    <Image x:Name="SourceImage"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           Stretch="Fill" />
                    <Border Width="{Binding ActualWidth, ElementName=CropFrame}"
                            Height="{Binding ActualHeight, ElementName=CropFrame}"
                            BorderBrush="#A6FFFFFF"
                            BorderThickness="1"
                            IsHitTestVisible="False" />
                </Canvas>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,6,0,0">
                <TextBlock Foreground="#7B8BA2" FontSize="12" Text="缩放" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="ZoomSlider"
                            VerticalAlignment="Center"
                            Minimum="1"
                            Maximum="3"
                            Value="1"
                            SmallChange="0.05"
                            LargeChange="0.2"
                            ValueChanged="ZoomSlider_ValueChanged" />
                    <TextBlock x:Name="ZoomValueText"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#7B8BA2"
                               FontSize="12"
                               Text="100%" />
                </Grid>

                <Button Margin="0,18,0,0"
                        Width="108"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Content="重置位置"
                        Click="ResetPosition_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="86"
                    Margin="0,0,10,0"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Content="取消"
                    IsCancel="True" />
            <Button Width="86"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Content="保存"
                    IsDefault="True"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
