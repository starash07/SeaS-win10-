<Window x:Class="SeaS.App.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="158"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style x:Key="TrayMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.74" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogRoot"
            Padding="7"
            Background="{DynamicResource MainBackgroundBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="13">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="3"
                              Direction="270"
                              Color="#6A8797"
                              Opacity="0.16" />
        </Border.Effect>

        <StackPanel>
            <Button Style="{StaticResource TrayMenuButtonStyle}" Click="OpenButton_Click">
                <TextBlock VerticalAlignment="Center"
                           Text="打开主界面" />
            </Button>

            <Border Height="1"
                    Margin="8,5"
                    Background="{DynamicResource LineBrush}" />

            <Button Style="{StaticResource TrayMenuButtonStyle}" Click="ImportButton_Click">
                <TextBlock VerticalAlignment="Center"
                           Text="导入书籍文件" />
            </Button>

            <Button Style="{StaticResource TrayMenuButtonStyle}" Click="ScanFolderButton_Click">
                <TextBlock VerticalAlignment="Center"
                           Text="扫描文件夹" />
            </Button>

            <Button Style="{StaticResource TrayMenuButtonStyle}" Click="ModeButton_Click">
                <TextBlock x:Name="ModeButtonText"
                           VerticalAlignment="Center" />
            </Button>

            <Border Height="1"
                    Margin="8,5"
                    Background="{DynamicResource LineBrush}" />

            <Button Foreground="#E24D4D"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="ExitButton_Click">
                <TextBlock VerticalAlignment="Center"
                           Text="退出 SeaS" />
            </Button>
        </StackPanel>
    </Border>
</Window>
