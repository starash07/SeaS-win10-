<Window x:Class="SeaS.App.BookDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑书籍信息"
        Width="620"
        Height="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="Assets/seas.png"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      CornerRadius="10"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border x:Name="DialogRoot"
            Background="{DynamicResource MainBackgroundBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="66" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="Transparent"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Margin="30,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Text="编辑书籍信息" />
            <Button Width="34"
                    Height="34"
                    Margin="0,6,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="关闭"
                    Click="CloseButton_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="10"
                           Text="&#xE711;" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="30,14,30,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="138"
                        Height="178"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource BookCardBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0"
                        CornerRadius="6"
                        ClipToBounds="True">
                    <Grid>
                        <Image x:Name="CoverPreviewImage"
                               Stretch="UniformToFill"
                               Visibility="Collapsed" />
                        <StackPanel x:Name="CoverEmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{DynamicResource FaintTextBrush}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="26"
                                       Text="&#xE8B9;" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Text="暂无封面" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Grid.Row="2"
                        Width="138"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Content="更换封面"
                        Click="ChooseCover_Click" />
                <Button x:Name="DeleteCoverButton"
                        Grid.Row="4"
                        Width="138"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DialogDangerButtonStyle}"
                        Content="删除自定义封面"
                        Click="DeleteCover_Click" />
            </Grid>

            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,1,0,0">
                <TextBlock Margin="2,0,0,7"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           Text="书名" />
                <TextBox x:Name="TitleBox"
                         Style="{StaticResource DialogTextBoxStyle}" />

                <TextBlock Margin="2,20,0,7"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           Text="作者" />
                <TextBox x:Name="AuthorBox"
                         Style="{StaticResource DialogTextBoxStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="Transparent">
        <StackPanel Margin="0,0,30,24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
            <Button Width="86"
                    Margin="0,0,10,0"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Content="取消"
                    IsCancel="True" />
            <Button Width="86"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Content="保存"
                    IsDefault="True"
                    Click="Save_Click" />
        </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
