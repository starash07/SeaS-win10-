<Window x:Class="SeaS.App.BookDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑书籍信息"
        Width="420"
        Height="270"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FBFD"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <TextBlock Foreground="#14243A" FontSize="20" FontWeight="SemiBold" Text="编辑书籍信息" />

        <StackPanel Grid.Row="2">
            <TextBlock Margin="2,0,0,6" Foreground="#7B8BA2" FontSize="12" Text="书名" />
            <TextBox x:Name="TitleBox" Height="38" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#DCEBF8" BorderThickness="1" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Margin="2,0,0,6" Foreground="#7B8BA2" FontSize="12" Text="作者" />
            <TextBox x:Name="AuthorBox" Height="38" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#DCEBF8" BorderThickness="1" />
        </StackPanel>

        <StackPanel Grid.Row="6" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="82" Margin="0,0,10,0" Content="取消" IsCancel="True" />
            <Button Width="82" Background="#4AA3FF" Foreground="White" BorderThickness="0" Content="保存" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
