<Window x:Class="SeaS.App.GroupManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="FlatDialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#F2F7FA" />
            <Setter Property="Foreground" Value="#3F4B52" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E5F1F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF"
            BorderBrush="#E5EEF3"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Color="#6A8797" Opacity="0.13" />
        </Border.Effect>
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Foreground="#3F4B52"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Text="分组排序" />
                <Button Width="30"
                        Height="30"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Cancel_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE8BB;" />
                </Button>
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="0,7,0,0"
                       Foreground="#81909A"
                       FontSize="12"
                       Text="拖动左侧把手调整顺序。点击分组名后的编辑图标可以直接修改名称。" />

            <Border Grid.Row="3"
                    Background="#F8FBFD"
                    CornerRadius="12">
                <Grid>
                    <ListBox x:Name="GroupListBox"
                             Margin="8"
                             AllowDrop="True"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding EditableGroups}"
                             PreviewMouseLeftButtonDown="GroupListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="GroupListBox_PreviewMouseMove"
                             Drop="GroupListBox_Drop">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10"
                                        Background="#FFFFFF"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#AAB6BD"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Text="&#xE712;" />
                                        <Grid Grid.Column="1"
                                              Margin="0,0,8,0">
                                            <TextBlock x:Name="GroupNameText"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#3F4B52"
                                                       FontSize="13"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBox x:Name="GroupNameEditor"
                                                     Height="32"
                                                     Padding="8,0"
                                                     VerticalContentAlignment="Center"
                                                     Background="#F8FBFD"
                                                     BorderBrush="#DCE8EF"
                                                     BorderThickness="1"
                                                     Foreground="#3F4B52"
                                                     FontSize="13"
                                                     LostFocus="GroupNameEditor_LostFocus"
                                                     KeyDown="GroupNameEditor_KeyDown"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="Collapsed" />
                                        </Grid>
                                        <Button Grid.Column="2"
                                                Width="30"
                                                Height="30"
                                                HorizontalAlignment="Right"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="StartEditGroup_Click"
                                                Tag="{Binding}">
                                            <TextBlock Foreground="#81909A"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Text="&#xE70F;" />
                                        </Button>
                                        <Button Grid.Column="3"
                                                Width="30"
                                                Height="30"
                                                HorizontalAlignment="Right"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="DeleteGroup_Click"
                                                Tag="{Binding}">
                                            <TextBlock Foreground="#D45B64"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Text="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Background" Value="#F8FBFD" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter TargetName="GroupNameText" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="GroupNameEditor" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyHint"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#AAB6BD"
                               FontSize="13"
                               Text="还没有自定义分组"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <TextBlock x:Name="ErrorText"
                       Grid.Row="4"
                       Margin="2,10,0,0"
                       Foreground="#D45B64"
                       FontSize="11.5" />

            <StackPanel Grid.Row="5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                <Button Width="82"
                        Margin="0,0,9,0"
                        Style="{StaticResource FlatDialogButtonStyle}"
                        Click="Cancel_Click"
                        Content="取消" />
                <Button Width="82"
                        Background="#C4EAB5"
                        Style="{StaticResource FlatDialogButtonStyle}"
                        Click="Confirm_Click"
                        Content="确定" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
