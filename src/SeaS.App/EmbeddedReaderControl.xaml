<UserControl x:Class="SeaS.App.EmbeddedReaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SeaS.App"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             PreviewKeyDown="Reader_PreviewKeyDown"
             PreviewKeyUp="Reader_PreviewKeyUp">
    <UserControl.Resources>
        <DropShadowEffect x:Key="ReaderPanelShadow" BlurRadius="28" ShadowDepth="0" Color="#5B798C" Opacity="0.12" />

        <Style x:Key="ReaderRailButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="38" ClipToBounds="True">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="19">
                                <Grid>
                                    <Grid Width="38" HorizontalAlignment="Left">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Margin="50,0,10,0"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               Text="{TemplateBinding Tag}" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveTextBrush}" />
                            </Trigger>
                            <Trigger Property="CommandParameter" Value="Active">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReaderPageButtonStyle" TargetType="Button" BasedOn="{StaticResource ReaderIconButtonStyle}">
            <Setter Property="Width" Value="118" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ReaderStepperButtonStyle" TargetType="Button" BasedOn="{StaticResource ReaderIconButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
        </Style>

        <Style x:Key="ReaderSegmentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="CommandParameter" Value="Active">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource MainBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="CommandParameter" Value="Active" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource MainBackgroundBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReaderListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Padding="10,0" MinHeight="42" Background="Transparent" CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchResultListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                MinHeight="74"
                                Background="Transparent"
                                CornerRadius="7">
                            <Grid>
                                <Border x:Name="AccentRail"
                                        Width="3"
                                        Margin="1,10,0,10"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"
                                        CornerRadius="2" />
                                <ContentPresenter Margin="14,10,12,10"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
                                <Setter TargetName="AccentRail" Property="Background" Value="{DynamicResource LineBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="AccentRail" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReaderSettingLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ReaderFontListItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemRoot"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReaderPanelScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbRoot" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbRoot" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                <Setter TargetName="ThumbRoot" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReaderPanelScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Margin" Value="2,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border Width="3"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource LineBrush}"
                                    CornerRadius="2" />
                            <Track x:Name="PART_Track"
                                   Margin="0,3"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ReaderPanelScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="ReaderRoot"
          Background="{DynamicResource ReaderBackgroundBrush}"
          SizeChanged="ReaderRoot_SizeChanged"
          PreviewMouseMove="ReaderRoot_PreviewMouseMove"
          MouseLeave="ReaderRoot_MouseLeave">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ReaderRailColumn" Width="68" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="ReaderRail"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Width="68"
                HorizontalAlignment="Left"
                Panel.ZIndex="30"
                Background="Transparent"
                BorderBrush="{DynamicResource SidebarEdgeBrush}"
                BorderThickness="0,0,1,0"
                ClipToBounds="True"
                MouseEnter="ReaderRail_MouseEnter"
                MouseLeave="ReaderRail_MouseLeave">
            <Grid>
                <Border Width="176"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SidebarBrush}"
                        IsHitTestVisible="False" />

                <Grid Width="38"
                      Height="38"
                      Margin="15,14,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <Image Width="38"
                           Height="38"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="Assets/seas.png"
                           Stretch="Uniform" />
                </Grid>

                <StackPanel x:Name="ReaderNavigation"
                            Margin="15,96,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                    <Button Tag="返回书架" ToolTip="返回书架" Style="{StaticResource ReaderRailButtonStyle}" Click="BackToShelf_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE72B;" />
                    </Button>
                    <Button x:Name="TocButton" Tag="章节目录" ToolTip="章节目录" Margin="0,8,0,0" Style="{StaticResource ReaderRailButtonStyle}" Click="ToggleToc_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE8FD;" />
                    </Button>
                    <Button x:Name="SearchButton" Tag="书内搜索" ToolTip="书内搜索" Margin="0,8,0,0" Style="{StaticResource ReaderRailButtonStyle}" Click="ToggleSearch_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE721;" />
                    </Button>
                    <Button x:Name="BookmarkButton" Tag="书签列表" ToolTip="书签列表" Margin="0,8,0,0" Style="{StaticResource ReaderRailButtonStyle}" Click="ToggleBookmarks_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE734;" />
                    </Button>
                    <Button x:Name="SettingsPanelButton" Tag="阅读设置" ToolTip="阅读设置" Margin="0,8,0,0" Style="{StaticResource ReaderRailButtonStyle}" Click="ToggleSettings_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE713;" />
                    </Button>
                    <Button x:Name="AutoPageButton" Tag="自动翻页" ToolTip="开启自动翻页" Margin="0,8,0,0" Style="{StaticResource ReaderRailButtonStyle}" Click="ToggleAutoPage_Click">
                        <TextBlock x:Name="AutoPageIcon" FontFamily="Segoe UI Symbol" FontSize="13" Text="▶" />
                    </Button>
                    <Button x:Name="ImmersiveModeButton" Tag="专注模式" ToolTip="开启专注模式" Margin="0,8,0,0" Style="{StaticResource ReaderRailButtonStyle}" Click="ToggleImmersiveMode_Click">
                        <TextBlock x:Name="ImmersiveModeIcon" FontFamily="Segoe UI Symbol" FontSize="15" Text="⛶" />
                    </Button>
                    <Button x:Name="ImmersiveMaximizeButton"
                            Tag="全屏窗口"
                            ToolTip="全屏窗口（最大化）"
                            Margin="0,8,0,0"
                            Style="{StaticResource ReaderRailButtonStyle}"
                            Visibility="Collapsed"
                            Click="ImmersiveMaximize_Click">
                        <TextBlock x:Name="ImmersiveMaximizeIcon" FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE740;" />
                    </Button>
                </StackPanel>

                <Button x:Name="ImmersiveCloseButton"
                        Tag="关闭窗口"
                        ToolTip="关闭窗口（收回托盘）"
                        Margin="15,0,0,17"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource ReaderRailButtonStyle}"
                        Visibility="Collapsed"
                        Click="CloseApp_Click">
                    <Viewbox Width="18" Height="18" IsHitTestVisible="False">
                        <Grid Width="24" Height="24">
                            <Path Data="M14,4 H6 C4.9,4 4,4.9 4,6 V18 C4,19.1 4.9,20 6,20 H14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <Path Data="M11,12 H21 M17,8 L21,12 L17,16"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Grid>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ReaderTopRow" Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="ReaderBottomRow" Height="56" />
            </Grid.RowDefinitions>

            <Grid x:Name="ReaderTopBar"
                  Grid.Row="0"
                  Background="#FAFFFFFF"
                  MouseLeftButtonDown="ReaderTopBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="92,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BookTitleText"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="BookAuthorText"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ChapterKickerText"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="10" />
                    <TextBlock x:Name="HeaderChapterTitleText"
                               Margin="0,3,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="0,0,20,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource ReaderIconButtonStyle}" ToolTip="最小化" Click="Minimize_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE921;" />
                    </Button>
                    <Button x:Name="ReaderMaximizeButton" Margin="4,0,0,0" Style="{StaticResource ReaderIconButtonStyle}" ToolTip="最大化" Click="Maximize_Click">
                        <TextBlock x:Name="ReaderMaximizeIcon" FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE922;" />
                    </Button>
                    <Button Margin="4,0,0,0" Style="{StaticResource ReaderIconButtonStyle}" ToolTip="关闭" Click="CloseApp_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="ReaderBody"
                  Grid.Row="1"
                  Background="Transparent"
                  ClipToBounds="True"
                  SizeChanged="ReaderBody_SizeChanged"
                  PreviewMouseWheel="ReaderScrollViewer_PreviewMouseWheel"
                  MouseLeftButtonDown="ReaderBody_MouseLeftButtonDown">
                <DocumentPageView x:Name="ReaderPageView"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  IsHitTestVisible="False"
                                  SnapsToDevicePixels="True"
                                  Stretch="Uniform"
                                  StretchDirection="DownOnly"
                                  Visibility="Collapsed">
                    <DocumentPageView.RenderTransform>
                        <TranslateTransform x:Name="ReaderPageTranslate" />
                    </DocumentPageView.RenderTransform>
                </DocumentPageView>
                <ScrollViewer x:Name="ReaderScrollViewer"
                              Background="Transparent"
                              Focusable="False"
                              FocusVisualStyle="{x:Null}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              ScrollChanged="ReaderScrollViewer_ScrollChanged">
                    <Grid x:Name="ArticleOuter" MinHeight="480">
                        <StackPanel x:Name="ArticlePanel"
                                    Width="940"
                                    Margin="0,44,0,86"
                                    HorizontalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="ArticleTranslate" />
                            </StackPanel.RenderTransform>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border x:Name="ChapterProgressRail"
                        Panel.ZIndex="18"
                        Width="18"
                        Margin="0,18,6,18"
                        Padding="0,4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        CornerRadius="9">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                        </Grid.RowDefinitions>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#C7DAE4"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="7"
                                   Text="&#xE70E;" />
                        <Grid x:Name="ChapterProgressTrack"
                              Grid.Row="1"
                              Width="8"
                              HorizontalAlignment="Center"
                              Background="Transparent"
                              MouseLeftButtonDown="ChapterProgressTrack_MouseLeftButtonDown"
                              MouseLeftButtonUp="ChapterProgressTrack_MouseLeftButtonUp"
                              MouseMove="ChapterProgressTrack_MouseMove"
                              SizeChanged="ProgressTrack_SizeChanged">
                            <Border Width="4"
                                    HorizontalAlignment="Center"
                                    Background="#E8F1F5"
                                    CornerRadius="2" />
                            <Border x:Name="ChapterProgressFill"
                                    Width="4"
                                    Height="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#CFDEE7"
                                    CornerRadius="2" />
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="ChapterProgressThumb"
                                        Canvas.Top="0"
                                        Width="4"
                                        Height="42"
                                        Background="#BFD3DD"
                                        CornerRadius="2" />
                            </Canvas>
                        </Grid>
                        <TextBlock Grid.Row="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#C7DAE4"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="7"
                                   Text="&#xE70D;" />
                    </Grid>
                </Border>

                <Border x:Name="Overlay"
                        Background="#44EBF2F6"
                        Visibility="Collapsed"
                        MouseLeftButtonDown="Overlay_MouseLeftButtonDown" />

                <Border x:Name="TocPanel"
                        Width="390"
                        Margin="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource MainBackgroundBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Effect="{StaticResource ReaderPanelShadow}"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,0">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" Text="章节目录" />
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ReaderIconButtonStyle}" Click="ClosePanels_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE8BB;" />
                            </Button>
                        </Grid>
                        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource LineBrush}" />
                        <ListBox x:Name="ChapterList"
                                 Grid.Row="1"
                                 Margin="10"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ItemContainerStyle="{StaticResource ReaderListBoxItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="ChapterList_SelectionChanged">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ReaderPanelScrollBarStyle}" />
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Text="{Binding Number, StringFormat={}{0:00}}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border x:Name="BookmarkPanel"
                        Width="330"
                        Margin="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource MainBackgroundBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Effect="{StaticResource ReaderPanelShadow}"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="112" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,0">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" Text="书签" />
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ReaderIconButtonStyle}" Click="ClosePanels_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE8BB;" />
                            </Button>
                        </Grid>
                        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource LineBrush}" />
                        <Grid Grid.Row="1" Margin="10">
                            <ListBox x:Name="BookmarkList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemContainerStyle="{StaticResource ReaderListBoxItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="BookmarkList_SelectionChanged"
                                     MouseDoubleClick="BookmarkList_MouseDoubleClick">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ReaderPanelScrollBarStyle}" />
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,7">
                                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="12"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{DynamicResource FaintTextBrush}"
                                                       FontSize="10"
                                                       Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="BookmarkEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="{DynamicResource FaintTextBrush}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="24"
                                           Text="&#xE734;" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="12"
                                           Text="还没有书签" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="2" VerticalAlignment="Top" Height="1" Background="{DynamicResource LineBrush}" />
                        <Grid Grid.Row="2" Margin="10,8,10,9">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{DynamicResource ControlSurfaceBrush}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <TextBox x:Name="BookmarkNameBox"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             FontSize="11"
                                             MaxLength="80" />
                                    <TextBlock Margin="11,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource FaintTextBrush}"
                                               FontSize="11"
                                               IsHitTestVisible="False"
                                               Text="书签名称（可选）">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=BookmarkNameBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="添加"
                                        Style="{StaticResource ReaderSegmentButtonStyle}"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        Click="AddBookmark_Click" />
                                <Button x:Name="DeleteBookmarkButton"
                                        Grid.Column="2"
                                        Content="删除"
                                        Style="{StaticResource ReaderSegmentButtonStyle}"
                                        Background="{DynamicResource ControlSurfaceBrush}"
                                        IsEnabled="False"
                                        Click="DeleteBookmark_Click" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="SettingsPanel"
                        Width="330"
                        Margin="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource MainBackgroundBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Effect="{StaticResource ReaderPanelShadow}"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,0">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" Text="阅读设置" />
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ReaderIconButtonStyle}" Click="ClosePanels_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE8BB;" />
                            </Button>
                        </Grid>
                        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource LineBrush}" />
                        <ScrollViewer x:Name="ReaderSettingsScrollViewer"
                                      Grid.Row="1"
                                      Focusable="False"
                                      FocusVisualStyle="{x:Null}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="ReaderSettingsScrollViewer_PreviewMouseWheel">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ReaderPanelScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <StackPanel Margin="20,18,20,22">
                                <TextBlock Style="{StaticResource ReaderSettingLabelStyle}" Text="正文字号" />
                                <Border Height="40" Margin="0,8,0,18" Background="{DynamicResource ControlSurfaceBrush}" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource ReaderStepperButtonStyle}" Click="DecreaseFont_Click"><TextBlock FontSize="18" Text="−" /></Button>
                                        <TextBlock x:Name="FontSizeText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" />
                                        <Button Grid.Column="2" Style="{StaticResource ReaderStepperButtonStyle}" Click="IncreaseFont_Click"><TextBlock FontSize="16" Text="+" /></Button>
                                    </Grid>
                                </Border>

                                <TextBlock Style="{StaticResource ReaderSettingLabelStyle}" Text="行间距" />
                                <Border Height="40" Margin="0,8,0,18" Background="{DynamicResource ControlSurfaceBrush}" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource ReaderStepperButtonStyle}" Click="DecreaseLineHeight_Click"><TextBlock FontSize="18" Text="−" /></Button>
                                        <TextBlock x:Name="LineHeightText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" />
                                        <Button Grid.Column="2" Style="{StaticResource ReaderStepperButtonStyle}" Click="IncreaseLineHeight_Click"><TextBlock FontSize="16" Text="+" /></Button>
                                    </Grid>
                                </Border>

                                <TextBlock Style="{StaticResource ReaderSettingLabelStyle}" Text="页边距" />
                                <Border Height="40" Margin="0,8,0,18" Background="{DynamicResource ControlSurfaceBrush}" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource ReaderStepperButtonStyle}" Click="DecreasePageMargin_Click"><TextBlock FontSize="18" Text="−" /></Button>
                                        <TextBlock x:Name="ContentWidthText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" />
                                        <Button Grid.Column="2" Style="{StaticResource ReaderStepperButtonStyle}" Click="IncreasePageMargin_Click"><TextBlock FontSize="16" Text="+" /></Button>
                                    </Grid>
                                </Border>

                                <TextBlock Style="{StaticResource ReaderSettingLabelStyle}" Text="正文字体" />
                                <Grid x:Name="FontFamilyPicker"
                                      Height="40"
                                      Margin="0,8,0,18">
                                    <Border x:Name="FontFamilyField"
                                            Background="{DynamicResource ControlSurfaceBrush}"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="FontFamilySearchBox"
                                                     Padding="12,0,2,0"
                                                     VerticalContentAlignment="Center"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                                     FontSize="12"
                                                     GotKeyboardFocus="FontFamilySearchBox_GotKeyboardFocus"
                                                     PreviewKeyDown="FontFamilySearchBox_PreviewKeyDown"
                                                     TextChanged="FontFamilySearchBox_TextChanged" />
                                            <Button Grid.Column="1"
                                                    Width="34"
                                                    Height="34"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource ReaderIconButtonStyle}"
                                                    Click="ToggleFontFamilyPopup_Click">
                                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10"
                                                           Text="&#xE70D;" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Popup x:Name="FontFamilyPopup"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           Placement="Bottom"
                                           PlacementTarget="{Binding ElementName=FontFamilyPicker}"
                                           PopupAnimation="Fade"
                                           StaysOpen="False"
                                           VerticalOffset="5"
                                           Closed="FontFamilyPopup_Closed">
                                        <Border Width="{Binding ActualWidth, ElementName=FontFamilyPicker}"
                                                MaxHeight="260"
                                                Padding="5"
                                                Background="{DynamicResource MainBackgroundBrush}"
                                                BorderBrush="{DynamicResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Effect="{StaticResource ReaderPanelShadow}">
                                            <ListBox x:Name="FontFamilyList"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     FocusVisualStyle="{x:Null}"
                                                     ItemContainerStyle="{StaticResource ReaderFontListItemStyle}"
                                                     ScrollViewer.CanContentScroll="False"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     PreviewMouseLeftButtonUp="FontFamilyList_PreviewMouseLeftButtonUp">
                                                <ListBox.Resources>
                                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ReaderPanelScrollBarStyle}" />
                                                </ListBox.Resources>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <TextBlock Style="{StaticResource ReaderSettingLabelStyle}" Text="翻页间隔（秒）" />
                                <Border Height="40" Margin="0,8,0,18" Background="{DynamicResource ControlSurfaceBrush}" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource ReaderStepperButtonStyle}" Click="DecreaseAutoPageInterval_Click"><TextBlock FontSize="18" Text="−" /></Button>
                                        <TextBlock x:Name="AutoPageIntervalText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" />
                                        <Button Grid.Column="2" Style="{StaticResource ReaderStepperButtonStyle}" Click="IncreaseAutoPageInterval_Click"><TextBlock FontSize="16" Text="+" /></Button>
                                    </Grid>
                                </Border>

                                <TextBlock Style="{StaticResource ReaderSettingLabelStyle}" Text="阅读方式" />
                                <Border Height="42"
                                        Margin="0,8,0,18"
                                        Background="{DynamicResource ControlSurfaceBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <Grid Margin="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ScrollModeButton" Grid.Column="0" Content="滚动" VerticalAlignment="Center" Style="{StaticResource ReaderSegmentButtonStyle}" Click="SetScrollMode_Click" />
                                        <Button x:Name="PageModeButton" Grid.Column="1" Content="翻页" VerticalAlignment="Center" Style="{StaticResource ReaderSegmentButtonStyle}" Click="SetPageMode_Click" />
                                    </Grid>
                                </Border>

                                <TextBlock Style="{StaticResource ReaderSettingLabelStyle}" Text="阅读主题" />
                                <Border Height="42"
                                        Margin="0,8,0,18"
                                        Background="{DynamicResource ControlSurfaceBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <Grid Margin="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="WhiteThemeButton" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource ReaderSegmentButtonStyle}" Click="SetWhiteTheme_Click">
                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="#FFFFFF" Stroke="{DynamicResource LineBrush}" StrokeThickness="1" />
                                                <TextBlock Text="净白" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="EyeThemeButton" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ReaderSegmentButtonStyle}" Click="SetEyeTheme_Click">
                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="#CFEBC3" />
                                                <TextBlock Text="护眼" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="NightThemeButton" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource ReaderSegmentButtonStyle}" Click="SetNightTheme_Click">
                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="#465157" />
                                                <TextBlock Text="夜间" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <TextBlock Style="{StaticResource ReaderSettingLabelStyle}" Text="自定义颜色" />
                                <Grid Margin="0,8,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Height="38"
                                            Style="{StaticResource ReaderSegmentButtonStyle}"
                                            Background="{DynamicResource ControlSurfaceBrush}"
                                            Click="SelectReaderBackgroundColor_Click">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <Border x:Name="CustomBackgroundSwatch"
                                                    Width="13"
                                                    Height="13"
                                                    Margin="0,0,6,0"
                                                    Background="{DynamicResource ReaderBackgroundBrush}"
                                                    BorderBrush="{DynamicResource LineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6" />
                                            <TextBlock Text="背景" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Height="38"
                                            Style="{StaticResource ReaderSegmentButtonStyle}"
                                            Background="{DynamicResource ControlSurfaceBrush}"
                                            Click="SelectReaderTextColor_Click">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <Border x:Name="CustomTextSwatch"
                                                    Width="13"
                                                    Height="13"
                                                    Margin="0,0,6,0"
                                                    Background="{DynamicResource PrimaryTextBrush}"
                                                    BorderBrush="{DynamicResource LineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6" />
                                            <TextBlock Text="文字" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="4"
                                            Height="38"
                                            Content="重置"
                                            Style="{StaticResource ReaderSegmentButtonStyle}"
                                            Background="{DynamicResource ControlSurfaceBrush}"
                                            Click="ResetReaderColors_Click" />
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border x:Name="SearchPanel"
                        Width="444"
                        Height="520"
                        Margin="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{DynamicResource MainBackgroundBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Effect="{StaticResource ReaderPanelShadow}"
                        Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SearchPanelTranslate" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="58" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="52" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="SearchPanelHeader"
                              Margin="18,0"
                              Background="Transparent"
                              Cursor="SizeAll"
                              MouseLeftButtonDown="SearchPanelHeader_MouseLeftButtonDown"
                              MouseLeftButtonUp="SearchPanelHeader_MouseLeftButtonUp"
                              MouseMove="SearchPanelHeader_MouseMove">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" Text="书内搜索" />
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ReaderIconButtonStyle}" Click="CloseSearch_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE8BB;" />
                            </Button>
                        </Grid>
                        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource LineBrush}" />

                        <Border Grid.Row="1"
                                Height="40"
                                Margin="14,9"
                                Background="{DynamicResource ControlSurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE721;" />
                                <TextBox x:Name="ReaderSearchBox"
                                         Grid.Column="1"
                                         Padding="0,0,8,0"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         FontSize="13"
                                         TextChanged="ReaderSearchBox_TextChanged"
                                         KeyDown="ReaderSearchBox_KeyDown" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="12,6,12,8">
                            <ListBox x:Name="SearchResultsList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemContainerStyle="{StaticResource SearchResultListBoxItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="SearchResultsList_SelectionChanged">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ReaderPanelScrollBarStyle}" />
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Foreground="{DynamicResource AccentDarkBrush}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding LocationText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <local:HighlightTextBlock Margin="0,6,0,0"
                                                                      MaxHeight="66"
                                                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                                                      HighlightBackground="{DynamicResource LimeBrush}"
                                                                      HighlightForeground="{DynamicResource LimeDarkBrush}"
                                                                      FontSize="13"
                                                                      LineHeight="21"
                                                                      LineStackingStrategy="BlockLineHeight"
                                                                      SourceText="{Binding Preview}"
                                                                      HighlightText="{Binding Keyword}"
                                                                      TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="SearchEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" FontFamily="Segoe MDL2 Assets" FontSize="24" Text="&#xE721;" />
                                <TextBlock x:Name="SearchEmptyHint" Margin="0,10,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Text="输入关键词开始搜索" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3" VerticalAlignment="Top" Height="1" Background="{DynamicResource LineBrush}" />
                        <Grid Grid.Row="3" Margin="12,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <Button Content="上一个" Style="{StaticResource ReaderSegmentButtonStyle}" Background="{DynamicResource ControlSurfaceBrush}" Click="SearchPrevious_Click" />
                            <TextBlock x:Name="SearchStatusText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Text="0 个结果" />
                            <Button Grid.Column="2" Content="下一个" Style="{StaticResource ReaderSegmentButtonStyle}" Background="{DynamicResource AccentSoftBrush}" Click="SearchNext_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ReaderBottomBar" Grid.Row="2" Background="#FAFFFFFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="138" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="138" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PreviousButton" Grid.Column="0" Margin="86,0,0,0" Style="{StaticResource ReaderPageButtonStyle}" Click="Previous_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Margin="0,0,7,0" FontFamily="Segoe MDL2 Assets" Text="&#xE76B;" />
                        <TextBlock x:Name="PreviousButtonText" Text="上一章" />
                    </StackPanel>
                </Button>

                <Grid x:Name="TotalProgressRail"
                      Grid.Column="1"
                      Width="520"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="62" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProgressPercentText"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11" />
                    <Grid x:Name="TotalProgressTrack"
                          Grid.Column="1"
                          Height="12"
                          Margin="12,0"
                          Background="Transparent"
                          MouseLeftButtonDown="TotalProgressTrack_MouseLeftButtonDown"
                          MouseLeftButtonUp="TotalProgressTrack_MouseLeftButtonUp"
                          MouseMove="TotalProgressTrack_MouseMove"
                          SizeChanged="ProgressTrack_SizeChanged">
                        <Border Height="4"
                                VerticalAlignment="Center"
                                Background="#E3EDF2"
                                CornerRadius="2" />
                        <Border x:Name="TotalProgressFill"
                                Width="0"
                                Height="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#9DC7DF"
                                CornerRadius="2" />
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="TotalProgressThumb"
                                    Canvas.Left="0"
                                    Canvas.Top="1"
                                    Width="10"
                                    Height="10"
                                    Background="#6FA4C1"
                                    BorderBrush="#FFFFFF"
                                    BorderThickness="2"
                                    CornerRadius="5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5"
                                                      ShadowDepth="1"
                                                      Color="#4E7185"
                                                      Opacity="0.22" />
                                </Border.Effect>
                            </Border>
                        </Canvas>
                    </Grid>
                    <TextBlock x:Name="ProgressPositionText"
                               Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11" />
                </Grid>

                <Button x:Name="NextButton" Grid.Column="2" Margin="0,0,22,0" Style="{StaticResource ReaderPageButtonStyle}" Click="Next_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="NextButtonText" Text="下一章" />
                        <TextBlock Margin="7,0,0,0" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Border x:Name="ReaderImagePreviewOverlay"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="#D8000000"
                Panel.ZIndex="90"
                Visibility="Collapsed"
                MouseLeftButtonDown="ReaderImagePreviewOverlay_MouseLeftButtonDown">
            <Grid Margin="78,48,30,30">
                <Image x:Name="ReaderImagePreview"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Button Width="38"
                        Height="38"
                        Margin="0,18,18,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource ReaderIconButtonStyle}"
                        Click="CloseReaderImagePreview_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="White"
                               Text="&#xE8BB;" />
                </Button>
            </Grid>
        </Border>

        <Border x:Name="ImmersiveHotZone"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Width="50"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Panel.ZIndex="60"
                Background="#01FFFFFF"
                MouseEnter="ImmersiveHotZone_MouseEnter"
                Visibility="Collapsed" />

        <StackPanel x:Name="FloatingWindowActions"
                    Grid.Column="1"
                    Margin="0,12,18,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Panel.ZIndex="50"
                    Visibility="Collapsed">
            <Button Style="{StaticResource ReaderIconButtonStyle}" ToolTip="最小化" Click="Minimize_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE921;" />
            </Button>
            <Button x:Name="FloatingMaximizeButton" Margin="4,0,0,0" Style="{StaticResource ReaderIconButtonStyle}" ToolTip="最大化" Click="Maximize_Click">
                <TextBlock x:Name="FloatingMaximizeIcon" FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE922;" />
            </Button>
            <Button Margin="4,0,0,0" Style="{StaticResource ReaderIconButtonStyle}" ToolTip="关闭" Click="CloseApp_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE8BB;" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
