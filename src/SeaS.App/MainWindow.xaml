                                     Margin="0,0,13,0"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     FontSize="12.5"
                                     GotKeyboardFocus="SearchBox_FocusChanged"
                                     LostKeyboardFocus="SearchBox_FocusChanged"
                                     TextChanged="SearchBox_TextChanged" />
                            <TextBlock x:Name="SearchPlaceholder"
                                       Grid.Column="1"
                                       Margin="0,0,13,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource FaintTextBrush}"
                                       FontSize="12.5"
                                       IsHitTestVisible="False"
                                       Text="搜索..." />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Width="28" Height="28" Style="{StaticResource IconButtonStyle}" ToolTip="最小化" Click="MinimizeWindow_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE921;" />
                        </Button>
                        <Button x:Name="MaximizeWindowButton" Width="28" Height="28" Margin="4,0,0,0" Style="{StaticResource IconButtonStyle}" ToolTip="最大化" Click="MaximizeWindow_Click">
                            <TextBlock x:Name="MaximizeWindowIcon" FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE922;" />
                        </Button>
                        <Button Width="28" Height="28" Margin="4,0,0,0" Style="{StaticResource IconButtonStyle}" ToolTip="关闭" Click="CloseWindow_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <ScrollViewer Focusable="False"
                                  FocusVisualStyle="{x:Null}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border x:Name="LibraryToolsPanel"
                                    Margin="0,0,0,15"
                                    Padding="10,5,10,7"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource LibraryToolsBackgroundBrush}"
                                    CornerRadius="16"
                                    Visibility="Collapsed">
                                <Grid>
                                    <StackPanel x:Name="LibraryNormalToolsPanel"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <TextBlock Margin="0,0,7,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource FaintTextBrush}"
                                                   FontSize="12.5"
                                                   Text="排序" />
                                        <ComboBox x:Name="SortModeComboBox"
                                                  Width="122"
                                                  Margin="0,0,12,0"
                                                  Style="{StaticResource LibrarySortComboBoxStyle}"
                                                  SelectedValuePath="Tag"
                                                  SelectionChanged="SortModeComboBox_SelectionChanged">
                                            <ComboBoxItem Tag="recent" Content="最近阅读" />
                                            <ComboBoxItem Tag="added" Content="最近添加" />
                                            <ComboBoxItem Tag="title" Content="书名" />
                                            <ComboBoxItem Tag="author" Content="作者" />
                                            <ComboBoxItem Tag="progress" Content="阅读进度" />
                                        </ComboBox>
                                        <Button x:Name="SortDirectionButton"
                                                Style="{StaticResource LibraryToolActionStyle}"
                                                Click="SortDirectionButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="22"
                                                        Height="22"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        CornerRadius="6">
                                                    <TextBlock x:Name="SortDirectionIcon"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentDarkBrush}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11"
                                                               Text="&#xE74B;" />
                                                </Border>
                                                <TextBlock x:Name="SortDirectionText"
                                                           VerticalAlignment="Center"
                                                           Text="降序" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource LibraryToolActionStyle}" Click="EnterBulkMode_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="22"
                                                        Height="22"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        CornerRadius="6">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource LimeDarkBrush}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11"
                                                               Text="&#xE762;" />
                                                </Border>
                                                <TextBlock VerticalAlignment="Center" Text="批量操作" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource LibraryToolActionStyle}" Click="CheckMissingBooks_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="22"
                                                        Height="22"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        CornerRadius="6">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource WarmAccentBrush}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11"
                                                               Text="&#xE9D9;" />
                                                </Border>
                                                <TextBlock VerticalAlignment="Center" Text="清理失效书籍" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="ShelfCountText"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource FaintTextBrush}"
                                                   FontSize="11.5"
                                                   Text="共 0 本" />
                                    </StackPanel>

                                    <StackPanel x:Name="BulkActionsPanel"
                                                HorizontalAlignment="Left"
                                                Orientation="Horizontal"
                                                Visibility="Collapsed">
                                        <TextBlock x:Name="BulkSelectionStatusText"
                                                   Margin="0,0,14,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Text="已选 0 本" />
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="SelectCurrentResults_Click">
                                            <TextBlock Text="全选当前结果" />
                                        </Button>
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="ClearBulkSelection_Click">
                                            <TextBlock Text="取消选择" />
                                        </Button>
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="BulkAddFavorite_Click">
                                            <TextBlock Text="加入收藏" />
                                        </Button>
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="BulkRemoveFavorite_Click">
                                            <TextBlock Text="取消收藏" />
                                        </Button>
                                        <Button x:Name="BulkMoveGroupButton"
                                                Style="{StaticResource FlatGroupActionStyle}"
                                                Click="BulkMoveGroupButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="移动到分组" />
                                                <TextBlock Margin="5,1,0,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10"
                                                           Text="&#xE70D;" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="BulkUngroup_Click">
                                            <TextBlock Text="设为未分组" />
                                        </Button>
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="BulkRemoveSelected_Click">
                                            <TextBlock Foreground="#D45B64" Text="从书架移除" />
                                        </Button>
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="ExitBulkMode_Click">
                                            <TextBlock Text="退出批量" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsControl x:Name="ShelfItemsControl"
                                          ItemsSource="{Binding ShelfBooks}"
                                          ItemTemplate="{StaticResource BookCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <StackPanel x:Name="GroupPageActionsPanel"
                                        Margin="0,0,0,12"
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                                <Button Style="{StaticResource FlatGroupActionStyle}" Click="AddGroup_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,5,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Text="&#xE710;" />
                                        <TextBlock VerticalAlignment="Center" Text="添加分组" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatGroupActionStyle}" Click="EditGroups_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,5,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Text="&#xE70F;" />
                                        <TextBlock VerticalAlignment="Center" Text="分组排序" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <ItemsControl x:Name="GroupSectionsItemsControl"
                                          ItemsSource="{Binding GroupSections}"
                                          ItemTemplate="{StaticResource GroupSectionTemplate}"
                                          Focusable="False"
                                          FocusVisualStyle="{x:Null}"
                                          KeyboardNavigation.TabNavigation="None"
                                          Visibility="Collapsed" />

                            <Grid x:Name="EmptyState" Height="330" Visibility="Collapsed">
                                <Border Width="318"
                                        Height="168"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource CardBrush}"
                                        CornerRadius="9"
                                        Effect="{StaticResource CardShadow}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="44"
                                                Height="44"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource LimeSoftBrush}"
                                                CornerRadius="22">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource LimeDarkBrush}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22"
                                                       Text="&#xE8F1;" />
                                        </Border>
                                        <TextBlock x:Name="EmptyStateTitle"
                                                   Margin="0,13,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="书架还是空的" />
                                        <TextBlock x:Name="EmptyStateHint"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   Text="拖入 TXT / EPUB / Markdown 文件，或从左侧导入" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="Toast"
                            Margin="0,0,4,4"
                            Padding="14,9"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource CardBrush}"
                            BorderThickness="0"
                            CornerRadius="8"
                            Effect="{StaticResource SurfaceShadow}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ToastText" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" />
                    </Border>
                </Grid>
            </Grid>

            <ContentControl x:Name="ReaderHost"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Panel.ZIndex="40"
                            Focusable="False"
                            FocusVisualStyle="{x:Null}"
                            Visibility="Collapsed" />

        </Grid>
    </Border>
</Window>
