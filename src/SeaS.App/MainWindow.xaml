                        <StackPanel Grid.Row="5"
                                    Margin="16,0,0,0">
                            <Button x:Name="HelpButton"
                                    AutomationProperties.Name="帮助"
                                    Tag="帮助"
                                    Style="{StaticResource SidebarActionStyle}"
                                    Margin="0,0,0,7"
