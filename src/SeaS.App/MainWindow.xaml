                        <Button x:Name="ModeToggleButton"
                                Grid.Row="0"
                                Grid.RowSpan="7"
                                Panel.ZIndex="2"
                                Tag="切换到摸鱼模式"
                                Width="57"
                                Height="57"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ModeBrush}"
                                BorderThickness="0"
                                Foreground="{DynamicResource SidebarActiveTextBrush}"
                                FocusVisualStyle="{x:Null}"
                                Cursor="Hand"
                                ToolTip="切换到摸鱼模式"
                                Click="ModeToggleButton_Click">
