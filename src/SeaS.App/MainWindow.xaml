<Window x:Class="SeaS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SeaS"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Icon="Assets/seas.png"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        MouseLeave="Window_MouseLeave"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="10"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2" Direction="270" Color="#6A8797" Opacity="0.055" />
        <DropShadowEffect x:Key="SurfaceShadow" BlurRadius="9" ShadowDepth="1" Direction="270" Color="#6A8797" Opacity="0.035" />

        <Style x:Key="SidebarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Height="36" ClipToBounds="True">
                            <Border x:Name="IconRoot" Background="Transparent" CornerRadius="18">
                                 <Grid>
                                    <Border x:Name="IconBubble"
                                            Width="36"
                                            Height="36"
                                            HorizontalAlignment="Left"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="18">
                                        <ContentPresenter x:Name="IconContent"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          TextElement.Foreground="{DynamicResource SidebarIconBrush}" />
                                    </Border>
                                     <Border x:Name="SelectedLabelBackground"
                                            Width="72"
                                             Margin="43,0,0,0"
                                             Padding="7,3"
                                             HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            CornerRadius="11">
                                        <TextBlock HorizontalAlignment="Left"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   TextOptions.TextFormattingMode="Display"
                                                   TextOptions.TextRenderingMode="ClearType"
                                                   Text="{TemplateBinding Tag}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBubble" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveTextBrush}" />
                            </Trigger>
                             <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IconRoot" Property="Background" Value="{DynamicResource SidebarSelectedItemBrush}" />
                                 <Setter TargetName="IconBubble" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                <Setter TargetName="IconRoot" Property="Margin" Value="{DynamicResource SidebarSelectedMargin}" />
                                <Setter TargetName="SelectedLabelBackground" Property="Background" Value="{DynamicResource SidebarSelectedLabelBrush}" />
                                <Setter TargetName="IconContent" Property="TextElement.Foreground" Value="{DynamicResource SidebarActiveIconBrush}" />
                                 <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                             </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarActionStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="36" ClipToBounds="True">
                            <Border x:Name="IconRoot" Background="Transparent" CornerRadius="18">
                                <Grid>
                                    <Border x:Name="IconBubble"
                                            Width="36"
                                            Height="36"
                                            HorizontalAlignment="Left"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="18">
                                        <ContentPresenter x:Name="IconContent"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          TextElement.Foreground="{DynamicResource SidebarIconBrush}" />
                                    </Border>
                                    <TextBlock Margin="50,0,12,0"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="ClearType"
                                               Text="{TemplateBinding Tag}" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBubble" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarToggleIconStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SidebarIconBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SidebarActiveIconBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarActionIconStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SidebarIconBrush}" />
        </Style>

        <Style x:Key="SidebarToggleVectorIconStyle" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource SidebarIconBrush}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SidebarActiveIconBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarActionVectorIconStyle" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource SidebarIconBrush}" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="136" />
            <Setter Property="Height" Value="186" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Width="120"
                                Height="168"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Padding="0"
                                Background="{Binding Converter={StaticResource CoverImageBrushConverter}}"
                                BorderBrush="{DynamicResource BookCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource BookCardCornerRadius}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsBatchSelected}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopTabStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Foreground" Value="{DynamicResource TopTabTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource TopTabIdleBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource TopTabHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TopTabTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TopTabSelectedTextBrush}" />
                                <Setter Property="FontWeight" Value="Medium" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopToolbarActionStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatGroupActionStyle" TargetType="Button" BasedOn="{StaticResource TopToolbarActionStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="LibraryToolActionStyle" TargetType="Button" BasedOn="{StaticResource TopToolbarActionStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibrarySortComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemRoot"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibrarySortComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0,28,0" />
            <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource LibrarySortComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <Border x:Name="Field"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                <Grid>
                                    <TextBlock Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               Text="{Binding SelectedItem.Content, RelativeSource={RelativeSource TemplatedParent}}"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False" />
                                    <TextBlock Margin="0,0,10,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="9"
                                               IsHitTestVisible="False"
                                               Text="&#xE70D;" />
                                    <ToggleButton Background="Transparent"
                                                  BorderThickness="0"
                                                  ClickMode="Press"
                                                  Focusable="False"
                                                  FocusVisualStyle="{x:Null}"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   VerticalOffset="5">
                                <Border Width="{Binding ActualWidth, ElementName=Root}"
                                        Padding="4"
                                        Background="{DynamicResource MainBackgroundBrush}"
                                        CornerRadius="7">
                                    <ScrollViewer Focusable="False"
                                                  FocusVisualStyle="{x:Null}"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Field" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Field" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupExpanderStyle" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel KeyboardNavigation.TabNavigation="None">
                            <ToggleButton x:Name="HeaderSite"
                                          Height="40"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          FocusVisualStyle="{x:Null}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBackground"
                                                Padding="12,0,10,0"
                                                Background="#00FFFFFF"
                                                CornerRadius="11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0"
                                                      VerticalAlignment="Center">
                                                    <TextBlock x:Name="SectionNameText"
                                                               MaxWidth="240"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBox x:Name="SectionNameEditor"
                                                             Width="190"
                                                             Height="28"
                                                             Padding="8,0"
                                                             VerticalContentAlignment="Center"
                                                             Background="#F8FBFD"
                                                             BorderBrush="{DynamicResource LineBrush}"
                                                             BorderThickness="1"
                                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                                             FontSize="13"
                                                             LostFocus="GroupSectionNameEditor_LostFocus"
                                                             KeyDown="GroupSectionNameEditor_KeyDown"
                                                             PreviewMouseLeftButtonDown="GroupSectionNameEditor_PreviewMouseLeftButtonDown"
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="Collapsed" />
                                                </Grid>
                                                <TextBlock x:Name="SectionEditIcon"
                                                           Grid.Column="2"
                                                           VerticalAlignment="Center"
                                                           Cursor="Hand"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource FaintTextBrush}"
                                                           MouseLeftButtonDown="GroupSectionEditIcon_MouseLeftButtonDown"
                                                           Text="&#xE70F;"
                                                           ToolTip="修改分组名称">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUngrouped}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="4"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FaintTextBrush}"
                                                           FontSize="11"
                                                           Text="{Binding BookCountText}" />
                                                <Border Grid.Column="7"
                                                        Height="1"
                                                        Margin="14,0,14,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource LineBrush}"
                                                        Opacity="0.32" />
                                                <StackPanel Grid.Column="8"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                    <TextBlock x:Name="StateText"
                                                               Margin="0,0,7,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource FaintTextBrush}"
                                                               FontSize="11.5"
                                                               Text="收起" />
                                                    <Path x:Name="ExpandGlyph"
                                                          Width="10"
                                                          Height="6"
                                                          VerticalAlignment="Center"
                                                          Data="M 1,1 L 5,5 L 9,1"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.7"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Stretch="None" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter TargetName="SectionNameText" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="SectionNameEditor" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="StateText" Property="Text" Value="展开" />
                                                <Setter TargetName="ExpandGlyph" Property="Width" Value="6" />
                                                <Setter TargetName="ExpandGlyph" Property="Height" Value="10" />
                                                <Setter TargetName="ExpandGlyph" Property="Data" Value="M 1,1 L 5,5 L 1,9" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBackground" Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
                                                <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                                                <Setter TargetName="ExpandGlyph" Property="Stroke" Value="{DynamicResource AccentDarkBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                                <Setter TargetName="HeaderBackground" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter TargetName="StateText" Property="Text" Value="松开放入" />
                                                <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                                                <Setter TargetName="ExpandGlyph" Property="Stroke" Value="{DynamicResource AccentDarkBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Opacity" Value="0.72" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ExpandSite"
                                              Margin="2,9,0,0"
                                              ContentSource="Content" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="BookCardTemplate">
            <Button Style="{StaticResource CardButtonStyle}"
                    PreviewMouseLeftButtonDown="BookCard_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="BookCard_PreviewMouseMove"
                    GiveFeedback="BookCard_GiveFeedback"
                    Click="BookCard_Click">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 Opened="BookContextMenu_Opened">
                        <MenuItem Header="打开" Click="OpenNormally_Click" />
                        <MenuItem Header="用 LittleFish 打开" Click="OpenWithLittleFish_Click" />
                        <Separator />
                        <MenuItem x:Name="FavoriteMenuItem" Header="收藏 / 取消收藏" Click="ToggleFavorite_Click" />
                        <MenuItem x:Name="MoveGroupMenuItem" Header="移动到分组" />
                        <MenuItem Header="编辑书籍信息" Click="EditBook_Click" />
                        <MenuItem Header="定位原文件" Click="RevealBook_Click" />
                        <Separator />
                        <MenuItem Header="从书架移除" Click="RemoveBook_Click" />
                    </ContextMenu>
                </Button.ContextMenu>

                <Grid Width="120"
                      Height="168"
                      ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.RowSpan="5"
                          Width="120"
                          Height="168"
                          Visibility="Collapsed">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCover}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border VerticalAlignment="Bottom"
                                Height="72">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00FFFFFF" />
                                    <GradientStop Offset="0.58" Color="#B8000000" />
                                    <GradientStop Offset="1" Color="#DD000000" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Margin="10,0,10,12"
                                    VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="White"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       LineHeight="17"
                                       MaxHeight="36"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Title}" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding Author}"
                                       Foreground="#DDEAF0"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Author}" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding LastOpenedAtText}"
                                       Foreground="#BFD5DE"
                                       FontSize="9.5"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.RowSpan="5"
                          Margin="12,18,12,10">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCover}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding Title}"
                                   MaxWidth="96"
                                   Foreground="{DynamicResource AccentDarkBrush}"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   LineHeight="20"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="ClearType"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}" />

                        <TextBlock Grid.Row="2"
                                   Text="{Binding Author}"
                                   MaxWidth="96"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10.5"
                                   FontWeight="Normal"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Author}" />

                        <TextBlock Grid.Row="3"
                                   Margin="0,0,0,8"
                                   VerticalAlignment="Bottom"
                                   Text="{Binding LastOpenedAtText}"
                                   Foreground="{DynamicResource FaintTextBrush}"
                                   FontSize="9.5"
                                   TextTrimming="CharacterEllipsis" />

                        <Border Grid.Row="4"
                                Padding="7,3"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource BookCardChipBrush}"
                                CornerRadius="7">
                            <TextBlock Text="{Binding FileSizeText}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="9.5"
                                       FontWeight="Normal" />
                        </Border>
                    </Grid>

                    <Button Width="24"
                            Height="24"
                            Margin="0,7,7,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource BookCardChipBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="收藏 / 取消收藏"
                            Click="FavoriteStar_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="White" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.78" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsBulkMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Width="15.5"
                              Height="15.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 12,2.2 L 14.9,8.4 L 21.7,9 L 16.5,13.5 L 18,20.1 L 12,16.7 L 6,20.1 L 7.5,13.5 L 2.3,9 L 9.1,8.4 Z"
                              Stretch="Uniform"
                              StrokeThickness="1.7"
                              StrokeLineJoin="Round">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="Transparent" />
                                    <Setter Property="Stroke" Value="{DynamicResource SecondaryTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource FavoriteStarBrush}" />
                                            <Setter Property="Stroke" Value="{DynamicResource FavoriteStarBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <TextBlock Margin="0,0,10,10"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Foreground="#D45B64"
                               FontSize="9.5"
                               Text="文件已丢失"
                               Visibility="Collapsed">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Grid.RowSpan="5"
                            Width="18"
                            Height="18"
                            Margin="0,7,7,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            BorderThickness="1.2"
                            CornerRadius="9"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Background" Value="{DynamicResource BookCardChipBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BookCardBorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsBulkMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBatchSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="8.5"
                                   Foreground="White"
                                   Text="&#xE73E;">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBatchSelected}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="GroupSectionTemplate">
            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                      Style="{StaticResource GroupExpanderStyle}"
                      AllowDrop="True"
                      PreviewDragOver="GroupSection_PreviewDragOver"
                      DragLeave="GroupSection_DragLeave"
                      Drop="GroupSection_Drop">
                <ItemsControl ItemsSource="{Binding Books}"
                              ItemTemplate="{StaticResource BookCardTemplate}"
                              Focusable="False"
                              FocusVisualStyle="{x:Null}"
                              KeyboardNavigation.TabNavigation="None">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Expander>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="WindowBorder"
