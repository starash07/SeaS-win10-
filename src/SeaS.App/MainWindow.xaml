                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SidebarActiveTextBrush}"
                                                   FontSize="13"
                                                   FontWeight="Normal"
                                                   Text="{TemplateBinding Tag}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ModeRoot" Property="Opacity" Value="0.88" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ModeRoot" Property="Opacity" Value="0.7" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
