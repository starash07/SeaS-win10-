<Window x:Class="SeaS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SeaS"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Icon="Assets/seas.png"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        MouseLeave="Window_MouseLeave"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="10"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2" Direction="270" Color="#6A8797" Opacity="0.055" />
        <DropShadowEffect x:Key="SurfaceShadow" BlurRadius="9" ShadowDepth="1" Direction="270" Color="#6A8797" Opacity="0.035" />

        <Style x:Key="SidebarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Height="36" ClipToBounds="True">
                             <Border x:Name="IconRoot" Background="{TemplateBinding Background}" CornerRadius="18">
                                 <Grid>
                                    <Grid Width="36" HorizontalAlignment="Left">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                     <Border x:Name="SelectedLabelBackground"
                                            Width="72"
                                             Margin="43,0,0,0"
                                             Padding="7,3"
                                             HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            CornerRadius="11">
                                        <TextBlock HorizontalAlignment="Left"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   TextOptions.TextFormattingMode="Display"
                                                   TextOptions.TextRenderingMode="ClearType"
                                                   Text="{TemplateBinding Tag}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconRoot" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveTextBrush}" />
                            </Trigger>
                             <Trigger Property="IsChecked" Value="True">
                                 <Setter TargetName="IconRoot" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                <Setter TargetName="IconRoot" Property="Margin" Value="{DynamicResource SidebarSelectedMargin}" />
                                <Setter TargetName="SelectedLabelBackground" Property="Background" Value="{DynamicResource SidebarSelectedLabelBrush}" />
                                 <Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                                 <Setter Property="FontWeight" Value="SemiBold" />
                             </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarActionStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="36" ClipToBounds="True">
                            <Border x:Name="IconRoot" Background="{TemplateBinding Background}" CornerRadius="18">
                                <Grid>
                                    <Grid Width="36" HorizontalAlignment="Left">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Margin="50,0,12,0"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="ClearType"
                                               Text="{TemplateBinding Tag}" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconRoot" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="136" />
            <Setter Property="Height" Value="186" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Width="120"
                                Height="168"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Padding="12,18,12,10"
                                Background="{DynamicResource BookCardBrush}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsBatchSelected}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#4FA3D8" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopTabStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,30,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Underline"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="#4FA3D8"
                                    CornerRadius="1"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#4FA3D8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Underline" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopToolbarActionStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatGroupActionStyle" TargetType="Button" BasedOn="{StaticResource TopToolbarActionStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="GroupExpanderStyle" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel KeyboardNavigation.TabNavigation="None">
                            <ToggleButton x:Name="HeaderSite"
                                          Height="40"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          FocusVisualStyle="{x:Null}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBackground"
                                                Padding="12,0,10,0"
                                                Background="#00FFFFFF"
                                                CornerRadius="11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0"
                                                      VerticalAlignment="Center">
                                                    <TextBlock x:Name="SectionNameText"
                                                               MaxWidth="240"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBox x:Name="SectionNameEditor"
                                                             Width="190"
                                                             Height="28"
                                                             Padding="8,0"
                                                             VerticalContentAlignment="Center"
                                                             Background="#F8FBFD"
                                                             BorderBrush="{DynamicResource LineBrush}"
                                                             BorderThickness="1"
                                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                                             FontSize="13"
                                                             LostFocus="GroupSectionNameEditor_LostFocus"
                                                             KeyDown="GroupSectionNameEditor_KeyDown"
                                                             PreviewMouseLeftButtonDown="GroupSectionNameEditor_PreviewMouseLeftButtonDown"
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="Collapsed" />
                                                </Grid>
                                                <TextBlock x:Name="SectionEditIcon"
                                                           Grid.Column="2"
                                                           VerticalAlignment="Center"
                                                           Cursor="Hand"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource FaintTextBrush}"
                                                           MouseLeftButtonDown="GroupSectionEditIcon_MouseLeftButtonDown"
                                                           Text="&#xE70F;"
                                                           ToolTip="修改分组名称">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUngrouped}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="4"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FaintTextBrush}"
                                                           FontSize="11"
                                                           Text="{Binding BookCountText}" />
                                                <Border Grid.Column="7"
                                                        Height="1"
                                                        Margin="14,0,14,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource LineBrush}"
                                                        Opacity="0.32" />
                                                <StackPanel Grid.Column="8"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                    <TextBlock x:Name="StateText"
                                                               Margin="0,0,7,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource FaintTextBrush}"
                                                               FontSize="11.5"
                                                               Text="收起" />
                                                    <Path x:Name="ExpandGlyph"
                                                          Width="10"
                                                          Height="6"
                                                          VerticalAlignment="Center"
                                                          Data="M 1,1 L 5,5 L 9,1"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.7"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Stretch="None" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter TargetName="SectionNameText" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="SectionNameEditor" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="StateText" Property="Text" Value="展开" />
                                                <Setter TargetName="ExpandGlyph" Property="Width" Value="6" />
                                                <Setter TargetName="ExpandGlyph" Property="Height" Value="10" />
                                                <Setter TargetName="ExpandGlyph" Property="Data" Value="M 1,1 L 5,5 L 1,9" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBackground" Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
                                                <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                                                <Setter TargetName="ExpandGlyph" Property="Stroke" Value="{DynamicResource AccentDarkBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Opacity" Value="0.72" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ExpandSite"
                                              Margin="2,9,0,0"
                                              ContentSource="Content" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="BookCardTemplate">
            <Button Style="{StaticResource CardButtonStyle}"
                    Click="BookCard_Click">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 Opened="BookContextMenu_Opened">
                        <MenuItem Header="正式阅读" Click="OpenNormally_Click" />
                        <MenuItem Header="用 LittleFish 打开" Click="OpenWithLittleFish_Click" />
                        <Separator />
                        <MenuItem x:Name="FavoriteMenuItem" Header="收藏 / 取消收藏" Click="ToggleFavorite_Click" />
                        <MenuItem x:Name="MoveGroupMenuItem" Header="移动到分组" />
                        <MenuItem Header="编辑书籍信息" Click="EditBook_Click" />
                        <MenuItem Header="定位原文件" Click="RevealBook_Click" />
                        <Separator />
                        <MenuItem Header="从书架移除" Click="RemoveBook_Click" />
                    </ContextMenu>
                </Button.ContextMenu>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="{Binding Title}"
                                   MaxWidth="96"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}" />
                        <Border Width="20"
                                Height="20"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource LimeSoftBrush}"
                                CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{DynamicResource LimeDarkBrush}"
                                       Text="&#xEB51;" />
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="{Binding Author}"
                               MaxWidth="96"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="10.5"
                               FontWeight="Normal"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Author}" />

                    <Grid Grid.Row="4">
                        <Border Padding="7,3"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="7">
                            <TextBlock Text="{Binding FileSizeText}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="9.5"
                                       FontWeight="Normal" />
                        </Border>
                        <TextBlock HorizontalAlignment="Right"
                                   Foreground="#D45B64"
                                   FontSize="9.5"
                                   Text="文件已丢失"
                                   Visibility="Collapsed">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.RowSpan="5"
                            Width="22"
                            Height="22"
                            Margin="0,-7,-5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            BorderThickness="1.3"
                            CornerRadius="11"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Background" Value="#F8FBFD" />
                                <Setter Property="BorderBrush" Value="{DynamicResource FaintTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsBulkMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBatchSelected}" Value="True">
                                        <Setter Property="Background" Value="#4FA3D8" />
                                        <Setter Property="BorderBrush" Value="#4FA3D8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="White"
                                   Text="&#xE73E;">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBatchSelected}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="GroupSectionTemplate">
            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                      Style="{StaticResource GroupExpanderStyle}">
                <ItemsControl ItemsSource="{Binding Books}"
                              ItemTemplate="{StaticResource BookCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Expander>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="WindowBorder"
            Background="{DynamicResource MainBackgroundBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True"
            MouseLeftButtonDown="WindowBorder_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarBorder"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Width="68"
                    HorizontalAlignment="Left"
                    Panel.ZIndex="20"
                    Background="Transparent"
                    BorderBrush="{DynamicResource SidebarEdgeBrush}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="10,0,0,10"
                    ClipToBounds="True">
                <Grid>
                    <Border Width="176"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource SidebarBrush}"
                            CornerRadius="10,0,0,10"
                            IsHitTestVisible="False" />

                    <Grid Width="38"
                          Height="38"
                          Margin="15,14,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Grid>
                            <Image x:Name="SeaSLogo"
                                   Width="38"
                                   Height="38"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="Assets/seas.png"
                                   Stretch="Uniform" />
                            <Image x:Name="LittleFishLogo"
                                   Width="32"
                                   Height="32"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="Assets/littlefish.png"
                                   Stretch="Uniform"
                                   Visibility="Collapsed" />
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="SidebarNavigation" Margin="16,84,0,0" VerticalAlignment="Top">
                        <ToggleButton Tag="书架"
                                      CommandParameter="all"
                                      IsChecked="True"
                                      Style="{StaticResource SidebarToggleStyle}"
                                      Click="NavFilter_Click">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="&#xE8F1;" />
                        </ToggleButton>
                        <ToggleButton Tag="最近阅读"
                                      CommandParameter="recent"
                                      Margin="0,7,0,0"
                                      Style="{StaticResource SidebarToggleStyle}"
                                      Click="NavFilter_Click">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="&#xE823;" />
                        </ToggleButton>
                        <Button Tag="导入文件"
                                Margin="0,7,0,0"
                                Style="{StaticResource SidebarActionStyle}"
                                Click="ImportFiles_Click">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="&#xE8E5;" />
                        </Button>
                        <Button Tag="扫描文件夹"
                                Margin="0,7,0,0"
                                Style="{StaticResource SidebarActionStyle}"
                                Click="ScanFolder_Click">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="&#xE8B7;" />
                        </Button>
                    </StackPanel>

                    <Button x:Name="ModeToggleButton"
                            Tag="切换到摸鱼模式"
                            Width="57"
                            Height="57"
                            Margin="5,329,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{DynamicResource ModeBrush}"
                            BorderThickness="0"
                            Foreground="{DynamicResource SidebarActiveTextBrush}"
                            FocusVisualStyle="{x:Null}"
                            Cursor="Hand"
                            ToolTip="切换到摸鱼模式"
                            Click="ModeToggleButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Height="57" ClipToBounds="True">
                                    <Border x:Name="ModeRoot"
                                            Width="57"
                                            HorizontalAlignment="Left"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="29">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Margin="70,0,6,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SidebarActiveTextBrush}"
                                               FontSize="13"
                                               FontWeight="Normal"
                                               Text="{TemplateBinding Tag}" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ModeRoot" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ModeRoot" Property="Opacity" Value="0.7" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="19" Text="&#xE8EE;" />
                    </Button>

                    <Button x:Name="SettingsButton"
                            Tag="设置"
                            Style="{StaticResource SidebarActionStyle}"
                            Margin="16,0,0,17"
                            VerticalAlignment="Bottom"
                            Click="Settings_Click">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="&#xE713;" />
                    </Button>
                </Grid>
            </Border>

            <Grid x:Name="ShelfView" Grid.Column="1" Margin="24,10,24,20" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="228" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="ShelfTabsPanel"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <ToggleButton x:Name="AllBooksTab"
                                      Content="全部书籍"
                                      CommandParameter="all"
                                      IsChecked="True"
                                      Style="{StaticResource TopTabStyle}"
                                      Click="TopViewTab_Click" />
                        <ToggleButton x:Name="GroupedBooksTab"
                                      Content="我的分组"
                                      CommandParameter="groups"
                                      Style="{StaticResource TopTabStyle}"
                                      Click="TopViewTab_Click" />
                        <ToggleButton x:Name="FavoriteBooksTab"
                                      Content="我的收藏"
                                      CommandParameter="favorite"
                                      Style="{StaticResource TopTabStyle}"
                                      Click="TopViewTab_Click" />
                    </StackPanel>

                    <TextBlock x:Name="RecentViewTitle"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="最近阅读"
                               Visibility="Collapsed" />

                    <TextBlock x:Name="ShelfCountText"
                               Grid.Column="2"
                               Margin="2,0,14,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource FaintTextBrush}"
                               FontSize="11.5"
                               Text="共 0 本" />

                    <Border Grid.Column="3"
                            Height="34"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ControlSurfaceBrush}"
                            BorderThickness="0"
                            CornerRadius="17">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE721;" />
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     Margin="0,0,13,0"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     FontSize="12.5"
                                     GotKeyboardFocus="SearchBox_FocusChanged"
                                     LostKeyboardFocus="SearchBox_FocusChanged"
                                     TextChanged="SearchBox_TextChanged" />
                            <TextBlock x:Name="SearchPlaceholder"
                                       Grid.Column="1"
                                       Margin="0,0,13,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource FaintTextBrush}"
                                       FontSize="12.5"
                                       IsHitTestVisible="False"
                                       Text="搜索..." />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Width="28" Height="28" Style="{StaticResource IconButtonStyle}" ToolTip="最小化" Click="MinimizeWindow_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE921;" />
                        </Button>
                        <Button Width="28" Height="28" Margin="4,0,0,0" Style="{StaticResource IconButtonStyle}" ToolTip="最大化" Click="MaximizeWindow_Click">
                            <TextBlock x:Name="MaximizeWindowIcon" FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE922;" />
                        </Button>
                        <Button Width="28" Height="28" Margin="4,0,0,0" Style="{StaticResource IconButtonStyle}" ToolTip="关闭" Click="CloseWindow_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <ScrollViewer Focusable="False"
                                  FocusVisualStyle="{x:Null}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border x:Name="LibraryToolsPanel"
                                    Margin="0,0,0,14"
                                    Padding="0,2,0,8"
                                    Background="Transparent"
                                    Visibility="Collapsed">
                                <Grid>
                                    <StackPanel x:Name="LibraryNormalToolsPanel"
                                                HorizontalAlignment="Left"
                                                Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource FaintTextBrush}"
                                                   FontSize="12"
                                                   Text="排序" />
                                        <ComboBox x:Name="SortModeComboBox"
                                                  Width="112"
                                                  Height="30"
                                                  Margin="0,0,8,0"
                                                  Padding="8,0"
                                                  VerticalContentAlignment="Center"
                                                  Background="{DynamicResource ControlSurfaceBrush}"
                                                  BorderBrush="{DynamicResource LineBrush}"
                                                  BorderThickness="1"
                                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                                  FontSize="12"
                                                  SelectedValuePath="Tag"
                                                  SelectionChanged="SortModeComboBox_SelectionChanged">
                                            <ComboBoxItem Tag="recent" Content="最近阅读" />
                                            <ComboBoxItem Tag="added" Content="最近添加" />
                                            <ComboBoxItem Tag="title" Content="书名" />
                                            <ComboBoxItem Tag="author" Content="作者" />
                                            <ComboBoxItem Tag="progress" Content="阅读进度" />
                                        </ComboBox>
                                        <Button x:Name="SortDirectionButton"
                                                Style="{StaticResource FlatGroupActionStyle}"
                                                Click="SortDirectionButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="SortDirectionIcon"
                                                           Margin="0,0,5,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           Text="&#xE74B;" />
                                                <TextBlock x:Name="SortDirectionText"
                                                           VerticalAlignment="Center"
                                                           Text="降序" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="EnterBulkMode_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Margin="0,0,5,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           Text="&#xE762;" />
                                                <TextBlock VerticalAlignment="Center" Text="批量操作" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="CheckMissingBooks_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Margin="0,0,5,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           Text="&#xE9D9;" />
                                                <TextBlock VerticalAlignment="Center" Text="检测失效书籍" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel x:Name="BulkActionsPanel"
                                                HorizontalAlignment="Left"
                                                Orientation="Horizontal"
                                                Visibility="Collapsed">
                                        <TextBlock x:Name="BulkSelectionStatusText"
                                                   Margin="0,0,14,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Text="已选 0 本" />
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="SelectCurrentResults_Click">
                                            <TextBlock Text="全选当前结果" />
                                        </Button>
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="ClearBulkSelection_Click">
                                            <TextBlock Text="取消选择" />
                                        </Button>
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="BulkAddFavorite_Click">
                                            <TextBlock Text="加入收藏" />
                                        </Button>
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="BulkRemoveFavorite_Click">
                                            <TextBlock Text="取消收藏" />
                                        </Button>
                                        <Button x:Name="BulkMoveGroupButton"
                                                Style="{StaticResource FlatGroupActionStyle}"
                                                Click="BulkMoveGroupButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="移动到分组" />
                                                <TextBlock Margin="5,1,0,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10"
                                                           Text="&#xE70D;" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="BulkUngroup_Click">
                                            <TextBlock Text="设为未分组" />
                                        </Button>
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="BulkRemoveSelected_Click">
                                            <TextBlock Foreground="#D45B64" Text="从书架移除" />
                                        </Button>
                                        <Button Style="{StaticResource FlatGroupActionStyle}" Click="ExitBulkMode_Click">
                                            <TextBlock Text="退出批量" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsControl x:Name="ShelfItemsControl"
                                          ItemsSource="{Binding ShelfBooks}"
                                          ItemTemplate="{StaticResource BookCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <StackPanel x:Name="GroupPageActionsPanel"
                                        Margin="0,0,0,12"
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                                <Button Style="{StaticResource FlatGroupActionStyle}" Click="AddGroup_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,5,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Text="&#xE710;" />
                                        <TextBlock VerticalAlignment="Center" Text="添加分组" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatGroupActionStyle}" Click="EditGroups_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,5,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Text="&#xE70F;" />
                                        <TextBlock VerticalAlignment="Center" Text="分组排序" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <ItemsControl x:Name="GroupSectionsItemsControl"
                                          ItemsSource="{Binding GroupSections}"
                                          ItemTemplate="{StaticResource GroupSectionTemplate}"
                                          Visibility="Collapsed" />

                            <Grid x:Name="EmptyState" Height="330" Visibility="Collapsed">
                                <Border Width="318"
                                        Height="168"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource CardBrush}"
                                        CornerRadius="9"
                                        Effect="{StaticResource CardShadow}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="44"
                                                Height="44"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource LimeSoftBrush}"
                                                CornerRadius="22">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource LimeDarkBrush}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22"
                                                       Text="&#xE8F1;" />
                                        </Border>
                                        <TextBlock x:Name="EmptyStateTitle"
                                                   Margin="0,13,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="书架还是空的" />
                                        <TextBlock x:Name="EmptyStateHint"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   Text="拖入 TXT 文件，或从左侧导入" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="Toast"
                            Margin="0,0,4,4"
                            Padding="14,9"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource CardBrush}"
                            BorderThickness="0"
                            CornerRadius="8"
                            Effect="{StaticResource SurfaceShadow}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ToastText" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" />
                    </Border>
                </Grid>
            </Grid>

            <ContentControl x:Name="ReaderHost"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Panel.ZIndex="40"
                            Focusable="False"
                            FocusVisualStyle="{x:Null}"
                            Visibility="Collapsed" />

        </Grid>
    </Border>
</Window>
