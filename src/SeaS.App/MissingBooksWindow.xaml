<Window x:Class="SeaS.App.MissingBooksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="失效书籍"
        Width="620"
        Height="440"
        MinWidth="540"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Text="检测到失效书籍" />
            <TextBlock x:Name="HintText"
                       Margin="0,7,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12.5"
                       Text="下面这些书籍的原 TXT 文件已经找不到。确认后只会从 SeaS 书架移除记录，不会删除本地文件。" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <ListBox x:Name="MissingBooksList"
                     Margin="4"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemsSource="{Binding Items}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root"
                                            Padding="10,8"
                                            Background="Transparent"
                                            CornerRadius="8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="{DynamicResource FaintTextBrush}"
                                           FontSize="11"
                                           Text="{Binding FilePath}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="4">
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <Button Style="{StaticResource ActionButtonStyle}"
                        Padding="12,0"
                        Click="SelectAll_Click"
                        Content="全选" />
                <Button Margin="8,0,0,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Padding="12,0"
                        Click="ClearSelection_Click"
                        Content="取消选择" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Style="{StaticResource ActionButtonStyle}"
                        Padding="16,0"
                        Click="Cancel_Click"
                        Content="取消" />
                <Button Margin="10,0,0,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Padding="18,0"
                        Background="{DynamicResource AccentSoftBrush}"
                        Click="Confirm_Click"
                        Content="从书架移除所选" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
