<Window x:Class="SeaS.App.GroupNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360"
        Height="190"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Border Background="#FFFFFF"
            BorderBrush="#E5EEF3"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#6A8797" Opacity="0.12" />
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="DialogTitle"
                       Foreground="#3F4B52"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="添加分组" />

            <TextBox x:Name="NameBox"
                     Grid.Row="2"
                     Height="36"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#DCE8EF"
                     BorderThickness="1"
                     Foreground="#3F4B52"
                     FontSize="13"
                     KeyDown="NameBox_KeyDown" />

            <TextBlock x:Name="ErrorText"
                       Grid.Row="3"
                       Margin="2,7,0,0"
                       Foreground="#D45B64"
                       FontSize="11.5" />

            <StackPanel Grid.Row="4"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="74"
                        Height="32"
                        Margin="0,0,8,0"
                        Background="#F2F7FA"
                        BorderThickness="0"
                        Click="Cancel_Click"
                        Content="取消" />
                <Button Width="74"
                        Height="32"
                        Background="#C4EAB5"
                        BorderThickness="0"
                        Click="Confirm_Click"
                        Content="确定" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
